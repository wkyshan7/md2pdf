{
  "name": "md-studio",
  "version": "0.1.0",
  "description": "Markdown 排版 / 预览 / 多格式导出工具",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "python3 scripts/make-icons.py",
    "check:pwa": "node scripts/check-pwa.mjs",
    "verify": "npm run typecheck && npm run smoke && npm run build && npm run check:pwa",
    "smoke": "vite build --ssr scripts/smoke.ts --outDir .smoke --emptyOutDir && node .smoke/smoke.js"
  },
  "keywords": [
    "markdown",
    "pdf",
    "docx",
    "pptx"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "docx": "^9.7.1",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "katex": "^0.18.7",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
